# Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=put_your_bot_token_here

# Optional: server ID for instant slash-command updates during development.
# Leave blank for global commands, which can take up to an hour to update.
DISCORD_GUILD_ID=

# AI provider settings. The API must support OpenAI-compatible POST /chat/completions.
# OpenAI:
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=put_your_ai_api_key_here
AI_MODEL=gpt-4o-mini

# Local Ollama alternative:
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2

# Optional: RUST_LOG=info,serenity=warn
RUST_LOG=info
